# Copy to .env and fill in real values. EXPO_PUBLIC_* are bundled into the
# client, so only put non-secret values here (anon key is safe; service role is NOT).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# RevenueCat public SDK keys (safe to ship — they're scoped per-platform).
# Get from app.revenuecat.com → Project Settings → API keys.
# Leave both blank to disable the paywall (the gate becomes a no-op).
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
